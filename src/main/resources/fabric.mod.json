{
	"schemaVersion": 1,
	"id": "healthindicator",
	"version": "${version}",
	"name": "Health Indicator",
	"description": "Shows the health of the mob you look at in a HUD panel, and a health bar above every nearby mob. Client-only: works on any server.",
	"authors": [
		"firstwemine1-mc-dev"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.firstwemine1.healthindicator.platform.HealthIndicatorClient"
		]
	},
	"mixins": [
		"healthindicator.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
