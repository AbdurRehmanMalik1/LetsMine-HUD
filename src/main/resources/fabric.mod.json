{
	"schemaVersion": 1,
	"id": "indicatorbars",
	"version": "${version}",
	"name": "Indicator Bars",
	"description": "Client-side meters: health bars above mobs, a health panel for the mob you look at, and durability counters for tools and armor. Works on any server.",
	"authors": [
		"firstwemine1-mc-dev"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.firstwemine1.indicatorbars.platform.IndicatorBarsClient"
		]
	},
	"accessWidener": "indicatorbars.accesswidener",
	"mixins": [
		"indicatorbars.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.18.2",
		"java": ">=17",
		"fabric-api": "*"
	}
}
